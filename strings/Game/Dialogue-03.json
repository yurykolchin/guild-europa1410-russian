{
  "resource": "Game",
  "namespace": "Dialogue",
  "entries": [
    {
      "key": "CF48A9D04F5AE3E6B3DDA994FCBB4F93_C34977F700000000",
      "source_crc32": 510006918,
      "translation": "Даю неделю - и что-нибудь да загорится."
    },
    {
      "key": "CF68F965449C79EED9061EAB97C2ACC9_CF0B56A100000000",
      "source_crc32": 3867160655,
      "translation": "Любопытно. Вы способны на большее, чем я думал."
    },
    {
      "key": "CF798E3540FAFA0B501E86866E8F59C3_175ECB3A00000000",
      "source_crc32": 3729784685,
      "translation": "Вы могли бы оставить меня равнодушным. А оставили шрам."
    },
    {
      "key": "CFC1E4FC4A9396655BFEE79A7A6305F8_C34977F700000000",
      "source_crc32": 1301991306,
      "translation": "В следующий раз возьмём кого-нибудь, кто знает, что делает."
    },
    {
      "key": "CFE4BDD44DE1BDC62A014EB5879A329D_23F7653C00000000",
      "source_crc32": 576557763,
      "translation": "Добро пожаловать, хозяин! Только не проверяйте слишком строго!"
    },
    {
      "key": "D01311AA4044CFC54306139D7A5BA85E_1C82B0F900000000",
      "source_crc32": 3554137798,
      "translation": "Модернизация? А бочонок пива к ней прилагается?"
    },
    {
      "key": "D01595614FB944973A4567B9B21C83D3_9AD5AFAC00000000",
      "source_crc32": 2147927534,
      "translation": "Это было быстрее, чем я думала!"
    },
    {
      "key": "D05A0C514DFAFE17BC53DDB858ABB3C9_175ECB3A00000000",
      "source_crc32": 3847249331,
      "translation": "Такие поступки напоминают мне, за что я ценю нашу дружбу."
    },
    {
      "key": "D06164484AA06E43ACE284A31801A778_C34977F700000000",
      "source_crc32": 3221383664,
      "translation": "Будь в городе порядок, я бы осталась без дела."
    },
    {
      "key": "D085A42346E4E77ECCEDFF9D65447ABD_6DEF7CFD00000000",
      "source_crc32": 1156357230,
      "translation": "Надеюсь, я вас не разочаровал…"
    },
    {
      "key": "D19F599D45E301D24DFE7EB937A71AED_C34977F700000000",
      "source_crc32": 814895709,
      "translation": "Со взяткой - не здесь. Люди же смотрят."
    },
    {
      "key": "D1B49E0B4719F23A1378CFBEF0100406_9AD5AFAC00000000",
      "source_crc32": 3570961523,
      "translation": "Ой! Я просто… тут стояла. С толком, господин."
    },
    {
      "key": "D1C656824B755006B5E1E0993C5AE650_81CC668A00000000",
      "source_crc32": 1486548295,
      "translation": "Новшества? Чудесно! Жутко! Но чудесно!"
    },
    {
      "key": "D1E06AFF46081C0F280A91932EE347B0_175ECB3A00000000",
      "source_crc32": 3156495238,
      "translation": "Вы ведь совсем меня не знаете, правда?"
    },
    {
      "key": "D2207F474C101839C0220395569854B5_DF32DCAE00000000",
      "source_crc32": 2063657341,
      "translation": "Ловкий ход. Я уважаю вас всё больше."
    },
    {
      "key": "D22CBC8B43ABA01B812CB2B7862BC9D5_2CB05ECA00000000",
      "source_crc32": 3769477329,
      "translation": "Хорошо. Мне руки-ноги ещё пригодятся."
    },
    {
      "key": "D27726CF4EEBE03401865188EE84DB6D_CF0B56A100000000",
      "source_crc32": 3867160655,
      "translation": "Любопытно. Вы способны на большее, чем я думал."
    },
    {
      "key": "D2CDB4264654D7900981368FD0385098_D24AD10000000000",
      "source_crc32": 1591746298,
      "translation": "Вы невиновны. Пусть всем вернётся покой."
    },
    {
      "key": "D2D212CD4A2B86AE83086984860E7FCC_175ECB3A00000000",
      "source_crc32": 995394450,
      "translation": "Это было… неожиданно. Благодарю вас."
    },
    {
      "key": "D2D7CE8F4F662D3D4550D3B4315F42EF_9399272200000000",
      "source_crc32": 2207690707,
      "translation": "Смело. Рискованно. Возможно, губительно."
    },
    {
      "key": "D31CF0774441B54ECD9F27A2E1CCCB9E_A9C21C2000000000",
      "source_crc32": 2993067472,
      "translation": "В следующий раз при встрече любезностей не ждите."
    },
    {
      "key": "D36C55264EF314AE5D4D65872759BF8C_5B5D6DF000000000",
      "source_crc32": 4155874759,
      "translation": "Здесь какая-то ошибка. Я к этому непричастна."
    },
    {
      "key": "D397BC9C4182CDCC18678B9FDE2C1585_6DEF7CFD00000000",
      "source_crc32": 1129935230,
      "translation": "Работать ночью? Что ж… надеюсь, звёзды составят мне компанию."
    },
    {
      "key": "D3B55E2C40BB6FE0DF4EB288449364D3_4360EB4000000000",
      "source_crc32": 3996452729,
      "translation": "Вы меня балуете. Не увлекайтесь, а то я привыкну."
    },
    {
      "key": "D3CB57A34B8C56EF543D5FB1DC81C61A_A9C21C2000000000",
      "source_crc32": 3620404895,
      "translation": "Мог бы и догадаться: порядочности от вас не жди!"
    },
    {
      "key": "D3F79CD3491D38D93901FFA6AF1165C1_5B5D6DF000000000",
      "source_crc32": 1170920021,
      "translation": "Если вы терпеливы и не боитесь тишины… у нас может получиться."
    },
    {
      "key": "D42620C5426328F8B5CDBE887DC0BC44_2CB05ECA00000000",
      "source_crc32": 55764198,
      "translation": "Повезёт - следующий будет знать хоть половину того, что я."
    },
    {
      "key": "D456AEFC4615F581FB52BEBCA85C39CF_5B5D6DF000000000",
      "source_crc32": 3357861188,
      "translation": "Что ж. Похоже, придётся соответствовать."
    },
    {
      "key": "D4BCD97E48BECB98C8EDFF83E1A6A5C2_C34977F700000000",
      "source_crc32": 4190539367,
      "translation": "Хорошо. Теперь ворам придётся попотеть."
    },
    {
      "key": "D4F6A0EE44FF563BB08CF3B59B387A70_6DEF7CFD00000000",
      "source_crc32": 2704045781,
      "translation": "В том углу что-то… растёт. Я назвал его Гарольдом."
    },
    {
      "key": "D5D6A20844DBEC26FC7D8CA80E38C020_9AD5AFAC00000000",
      "source_crc32": 175270351,
      "translation": "До завтра! Если не просплю."
    },
    {
      "key": "D607BA35470883772B301D9B88EC3B16_5B5D6DF000000000",
      "source_crc32": 3966820336,
      "translation": "Это было сделано на редкость изящно."
    },
    {
      "key": "D60F4C8A428BA6F8B8E86294332B9060_6DEF7CFD00000000",
      "source_crc32": 4151256441,
      "translation": "Доброе утро. Я принёс немного хлеба, если кто проголодался."
    },
    {
      "key": "D61E7ABC429C75CAD2A45C851C1B12D6_81104BAA00000000",
      "source_crc32": 2248568754,
      "translation": "Я принесу столько всего, что понадобится склад побольше."
    },
    {
      "key": "D6691C9C44C9D0ACD108A282C7D8889E_6DEF7CFD00000000",
      "source_crc32": 1613182356,
      "translation": "Всегда рад вас видеть, хозяйка."
    },
    {
      "key": "D6B5E9704AEB39C1ED2F4CA0D4CD512F_C34977F700000000",
      "source_crc32": 1631105587,
      "translation": "Могла бы тут вздремнуть - никто б и не заметил."
    },
    {
      "key": "D6CE1F87455ADC837C7A8C9EC0713ABB_EA47A70D00000000",
      "source_crc32": 2231177171,
      "translation": "Хозяин пришёл - похоже, придётся работать."
    },
    {
      "key": "D6E8FF3C4C9E0A8E95C2A0B6BB728DFD_D24AD10000000000",
      "source_crc32": 1591746298,
      "translation": "Вы невиновны. Пусть всем вернётся покой."
    },
    {
      "key": "D71FCDE3418DAF05C1B5CD8DD38E9580_4360EB4000000000",
      "source_crc32": 1167645370,
      "translation": "Обещаю вечно смеяться над вашими ужасными шутками."
    },
    {
      "key": "D743E33C4B9EE91F9B6E168C43E8ED27_5DC48C6600000000",
      "source_crc32": 3592439202,
      "translation": "Ах, работа! Вечное проклятие способных."
    },
    {
      "key": "D75A4A2944E96CE4917B138F14BA15A1_CF0B56A100000000",
      "source_crc32": 817703708,
      "translation": "Вы нарушили закон, так извольте ответить. Вина доказана."
    },
    {
      "key": "D780D7E345D1FB7B6FB9D3A1E43DF869_DF32DCAE00000000",
      "source_crc32": 2198198650,
      "translation": "Хм. С расчётом или сгоряча - голос я приму."
    },
    {
      "key": "D7AEF5F74A6D8449545B4E917305B04A_5B5D6DF000000000",
      "source_crc32": 3077000952,
      "translation": "Вы дали мне повод пересмотреть своё мнение о вас."
    },
    {
      "key": "D81770B54933800E39D263A35C1C43EA_4360EB4000000000",
      "source_crc32": 3173471996,
      "translation": "Мы же дружили. Что, ради всего святого, случилось?"
    },
    {
      "key": "D86CD8294FA3FDFAE97191B0F6C9CA60_EA47A70D00000000",
      "source_crc32": 1511522894,
      "translation": "Раствор схватывается - самое время передохнуть."
    },
    {
      "key": "D8800E7849D210C3BBB22DBCB790B607_CF0B56A100000000",
      "source_crc32": 2198198650,
      "translation": "Хм. С расчётом или сгоряча - голос я приму."
    },
    {
      "key": "D88BBA1441733DEE9810AEBB36F0D4DE_D1251AB100000000",
      "source_crc32": 1953741247,
      "translation": "К вашим услугам, госпожа!"
    },
    {
      "key": "D8C84D484EF579DDE474FBB2EBF2A0DF_175ECB3A00000000",
      "source_crc32": 3226406517,
      "translation": "Ваша заботливость трогает меня больше, чем вы думаете."
    },
    {
      "key": "D922BB9B4AB41F4A1DC84CA703D34831_DF32DCAE00000000",
      "source_crc32": 179409748,
      "translation": "Да, это я. И сделала бы снова, если б пришлось."
    },
    {
      "key": "D9784BF34C27EE7DB0D1D5808949FD0D_716D583500000000",
      "source_crc32": 2929492549,
      "translation": "У каждого своя печаль. Просто одни прячут её лучше."
    },
    {
      "key": "D9F7AE2F41F65DC5472466897E3F3442_5B5D6DF000000000",
      "source_crc32": 1993661151,
      "translation": "Что ж, это разочаровывает. Я ждала от вас большего."
    },
    {
      "key": "DA264B804535AB062168C7AB206819F3_9399272200000000",
      "source_crc32": 1937982187,
      "translation": "Тщательно взвесив каждую мелочь, суд признаёт вашу вину."
    },
    {
      "key": "DA7D13DF4A24744112496B9DDC1A561F_4360EB4000000000",
      "source_crc32": 1194838204,
      "translation": "Моё сердце разбито, а я ещё даже вина не выпила."
    },
    {
      "key": "DA81DFDA4D169731B764F6BDBD4CF88C_81CC668A00000000",
      "source_crc32": 1218363058,
      "translation": "Готово. Если только я ничего не забыла. Точно что-то забыла."
    },
    {
      "key": "DA85547544D5A6944B393DB7978067DE_CF0B56A100000000",
      "source_crc32": 2845558449,
      "translation": "Я никогда никому не сдавался - кроме вас!"
    },
    {
      "key": "DA90BA3745D5ABC87199E7BB5751EAF4_CAE9733A00000000",
      "source_crc32": 3015474824,
      "translation": "Повышение? То есть… ну конечно! Долго же вы собирались."
    },
    {
      "key": "DA997DC04D5C88E7DE58DD907524DEFA_716D583500000000",
      "source_crc32": 1911570876,
      "translation": "Столько заботы об этом месте… прямо на сердце теплеет."
    },
    {
      "key": "DB0543A2411CF5332FB449B970E571FD_EA47A70D00000000",
      "source_crc32": 645449751,
      "translation": "Ухожу отсюда в трактир… насовсем."
    },
    {
      "key": "DB53C060467A1E99A9A4309503828071_81104BAA00000000",
      "source_crc32": 3954895265,
      "translation": "Так! Инструменты, сапоги, карта, молитва… постойте - а плакать можно?"
    },
    {
      "key": "DB5E203F4AAA5BCD681BC6BF85D3F542_D24AD10000000000",
      "source_crc32": 3052680544,
      "translation": "Боюсь, всё указывает на вас. Обвинение доказано."
    },
    {
      "key": "DBCA5A0749A9CC5A3CB928A51B82A26C_EA47A70D00000000",
      "source_crc32": 1269121337,
      "translation": "Уверены? Я же ровно ничего не сделала."
    },
    {
      "key": "DC476E064631E08E9456AFB3B50FF8C1_9399272200000000",
      "source_crc32": 558949734,
      "translation": "Странно. Я думала, мы с вами сошлись на том, что я невыносима."
    },
    {
      "key": "DC6429EF4134B71046AACBB9B70E9EE2_A9C21C2000000000",
      "source_crc32": 1194838204,
      "translation": "Моё сердце разбито, а я ещё даже вина не выпил."
    },
    {
      "key": "DC74D69A4EE028C3D9EEC6A487CE1F70_1C82B0F900000000",
      "source_crc32": 3423220286,
      "translation": "Прекрасно! Теперь у моей кружки своя полка."
    },
    {
      "key": "DCB5CB8B4CBD4121B37597A5E2D9ABED_A9C21C2000000000",
      "source_crc32": 2920892767,
      "translation": "Вы снова превзошли мои и без того высокие ожидания!"
    },
    {
      "key": "DD2333C64FAC40AE33D9498A4779261B_DF32DCAE00000000",
      "source_crc32": 2278354080,
      "translation": "Выходит, силу вы всё-таки признаёте."
    },
    {
      "key": "DD2804C14BFDA859575B8D87102AE6C1_EA47A70D00000000",
      "source_crc32": 3962653008,
      "translation": "Проснулась уставшей. Всё равно пошла на работу. Это подвиг."
    },
    {
      "key": "DD4A622744FF75959705D582852B433A_5B5D6DF000000000",
      "source_crc32": 2044599336,
      "translation": "Для меня это непривычно… и всё же я не против."
    },
    {
      "key": "DD5485E64EFB6FE12B4B0493D4B0CCE8_A9C21C2000000000",
      "source_crc32": 2179012783,
      "translation": "Вот так неожиданность - но какая приятная!"
    },
    {
      "key": "DD765A754C6B45F6C09A008585698BD0_5DC48C6600000000",
      "source_crc32": 2108579935,
      "translation": "О нет. Только не эта задача - я сломаю ноготь, а то и хуже."
    },
    {
      "key": "DD9F01834424382E56267382460AAE5B_23F7653C00000000",
      "source_crc32": 1406713992,
      "translation": "Меня наняли?! Ох… какая ответственность."
    },
    {
      "key": "DE23779E4B47E8935E6D1E9DF496654D_DF32DCAE00000000",
      "source_crc32": 817703708,
      "translation": "Вы нарушили закон, так извольте ответить. Вина доказана."
    },
    {
      "key": "DE28E0A64628CDE1B703928623D60BE7_5B5D6DF000000000",
      "source_crc32": 473469538,
      "translation": "Такого я не ожидала. Хорошо сыграно."
    },
    {
      "key": "DE2C5EBB46CD11FA37D7D69BBDA1FDA5_CCF96D7300000000",
      "source_crc32": 888448326,
      "translation": "Добротные перила. Укреплённые лестницы. Наконец-то."
    },
    {
      "key": "DEBC5CCB42B1C9CF9C150F86BACB8456_81104BAA00000000",
      "source_crc32": 3575127287,
      "translation": "Кажется, я что-то погнул. В себе."
    },
    {
      "key": "DF042F1544E07D38506221A58063A053_81104BAA00000000",
      "source_crc32": 3727855898,
      "translation": "Секунду! Тут сложнее, чем кажется."
    },
    {
      "key": "DF0A8C0649237E51C7F09DA140F62C47_A9C21C2000000000",
      "source_crc32": 3620404895,
      "translation": "Мог бы и догадаться: порядочности от вас не жди!"
    },
    {
      "key": "DF2857C14DD9D1D78476EF8EF620CA0A_BCB2CF5000000000",
      "source_crc32": 1408152285,
      "translation": "Говорят, уборка прогонит духов. А я скажу… не всех."
    },
    {
      "key": "DFBD00624EE680788722E79EC27A368C_A9C21C2000000000",
      "source_crc32": 3996452729,
      "translation": "Вы меня балуете. Не увлекайтесь, а то я привыкну."
    },
    {
      "key": "DFFB0A1741BB93B73CE37E9E2AE65A8E_5DC48C6600000000",
      "source_crc32": 2024508671,
      "translation": "Ухожу, пока мою репутацию окончательно не втоптали в грязь."
    },
    {
      "key": "E007DE304443E372FC0EF9B44D89BEE8_A9C21C2000000000",
      "source_crc32": 2570014538,
      "translation": "С вами каждый день - как первая искра."
    },
    {
      "key": "E01D00DC4771DD52F182D59BFB08E7A5_175ECB3A00000000",
      "source_crc32": 1668491605,
      "translation": "Что ж, это на голос больше, чем отдал себе я сам."
    },
    {
      "key": "E02536D14A3E2B1ED395C88EC47E16A7_175ECB3A00000000",
      "source_crc32": 1937982187,
      "translation": "Тщательно взвесив каждую мелочь, суд признаёт вашу вину."
    },
    {
      "key": "E03C96D445E7507759EBA2B7D630C84B_DF32DCAE00000000",
      "source_crc32": 2198198650,
      "translation": "Хм. С расчётом или сгоряча - голос я приму."
    },
    {
      "key": "E06285874A9CDA2AC14A449A9CB3EB2D_A9C21C2000000000",
      "source_crc32": 4154114865,
      "translation": "Вы старались! Видно. Аж до боли."
    },
    {
      "key": "E07381F145790A437F5F48884884934D_175ECB3A00000000",
      "source_crc32": 416968350,
      "translation": "От содеянного мне не уйти. Я виновен."
    },
    {
      "key": "E0906A5443052BC2E120149EB63E5C61_D1251AB100000000",
      "source_crc32": 872486806,
      "translation": "Вот и день прошёл."
    },
    {
      "key": "E103618D44D8E3B0DAF359A2D286F9BA_D24AD10000000000",
      "source_crc32": 4155874759,
      "translation": "Здесь какая-то ошибка. Я к этому непричастен."
    },
    {
      "key": "E159A6894374C0711CC96EA84AF83C2C_2CB05ECA00000000",
      "source_crc32": 432738756,
      "translation": "День начался - не будем его терять."
    },
    {
      "key": "E195F1114CEC9DE795C8639E3AD84C28_716D583500000000",
      "source_crc32": 1865669936,
      "translation": "Приятно быть нужной. Сейчас же возьмусь за дело."
    },
    {
      "key": "E1B08D544C0F0FB3C228A783968F5BC9_DF32DCAE00000000",
      "source_crc32": 2063657341,
      "translation": "Ловкий ход. Я уважаю вас всё больше."
    },
    {
      "key": "E1B4C7AD4F40A3D8F4491083109678E4_C34977F700000000",
      "source_crc32": 3415153914,
      "translation": "Новый фокус. Всё тот же цирк."
    },
    {
      "key": "E1D80AB24F52C7CE01B5E9AE30949C9C_23F7653C00000000",
      "source_crc32": 1921107559,
      "translation": "Мне нужны… компресс, бальзам и завещание."
    },
    {
      "key": "E1EF3C074FF15D3A02659BA834BEF585_DF32DCAE00000000",
      "source_crc32": 2297802633,
      "translation": "Запомните этот день - мы только что выиграли выборы!"
    },
    {
      "key": "E22E08FE45CD7F0E3E23C99B57BC5E29_175ECB3A00000000",
      "source_crc32": 558949734,
      "translation": "Странно. Я думал, мы с вами сошлись на том, что я невыносим."
    },
    {
      "key": "E23A81254AFFA9B14248A4AA57CAB0B3_9CF73D2600000000",
      "source_crc32": 2359417715,
      "translation": "Добро пожаловать! У нас всё в порядке."
    },
    {
      "key": "E25633C8497B0ABA3D92B080D03EB81C_4360EB4000000000",
      "source_crc32": 460864964,
      "translation": "Даже враги не устоят перед моим обаянием!"
    },
    {
      "key": "E273BFC84BA1751BD52A55A1B0544372_BCB2CF5000000000",
      "source_crc32": 3234251032,
      "translation": "Луна ночью была странная. Не к добру это."
    },
    {
      "key": "E279C56A412B5478B9F9C4A6E9A02F19_A9C21C2000000000",
      "source_crc32": 3755369057,
      "translation": "Может, вы ещё не безнадёжны - кто бы мог подумать?"
    },
    {
      "key": "E2C45F534C4E24047A99CBA8BBD818E2_175ECB3A00000000",
      "source_crc32": 143552339,
      "translation": "Я бы усомнился в вашем здравомыслии - не будь это мне на руку."
    },
    {
      "key": "E2CDE7224A390B79D08E26A339A98F4F_CF0B56A100000000",
      "source_crc32": 2278354080,
      "translation": "Выходит, силу вы всё-таки признаёте."
    },
    {
      "key": "E359F6374C8C9159D13641929D32DCBF_CCF96D7300000000",
      "source_crc32": 4191133026,
      "translation": "Отлично! Если взорвётся, хоть узнаем, где ошибка."
    },
    {
      "key": "E3727DEE4A47288E1FB3F6BBF880B92A_9AD5AFAC00000000",
      "source_crc32": 3039737389,
      "translation": "Если я сегодня поймаю вора, меня повысят?"
    },
    {
      "key": "E380786B47E39678E5F1718B20F8BB20_D1251AB100000000",
      "source_crc32": 51114535,
      "translation": "Ладно. Время не потеряю. А вы не тратьте моё зря."
    },
    {
      "key": "E415104E4DB0EE8CCFD652B8993612C3_175ECB3A00000000",
      "source_crc32": 3550635832,
      "translation": "Это предательство ранит тем больнее, что вы были мне дороги."
    },
    {
      "key": "E41539B5423F15ABE52399897A185904_D1251AB100000000",
      "source_crc32": 2002597316,
      "translation": "Инструмент не спорит. За это я его и люблю."
    },
    {
      "key": "E42FAF0A4D00076B95B68A8C7F500267_6562362600000000",
      "source_crc32": 640148763,
      "translation": "Наняли во вторник… любопытная примета."
    },
    {
      "key": "E44216C645BE5E173BED148834B5E63C_175ECB3A00000000",
      "source_crc32": 3550635832,
      "translation": "Это предательство ранит тем больнее, что вы были мне дороги."
    },
    {
      "key": "E442C35F4DD8EE081BB485A117048627_175ECB3A00000000",
      "source_crc32": 3554992739,
      "translation": "Подозрения были, но улики не выдерживают проверки: вы невиновны."
    },
    {
      "key": "E48331B1403694472144CF92EBCCDD1F_D24AD10000000000",
      "source_crc32": 1170920021,
      "translation": "Если вы терпеливы и не боитесь тишины… у нас может получиться."
    },
    {
      "key": "E496116942CF62E07B11F9860494829C_CF0B56A100000000",
      "source_crc32": 2198198650,
      "translation": "Хм. С расчётом или сгоряча - голос я приму."
    },
    {
      "key": "E52039E74C493C8B2AD583A65789499E_A9C21C2000000000",
      "source_crc32": 1228401192,
      "translation": "Назову первенца в вашу честь!"
    },
    {
      "key": "E52CFF184C46DF1C3AD26A9A7A25C20A_4360EB4000000000",
      "source_crc32": 2920892767,
      "translation": "Вы снова превзошли мои и без того высокие ожидания!"
    },
    {
      "key": "E5409AEC4F79500628AF6D92707720FE_5324210700000000",
      "source_crc32": 3479872336,
      "translation": "Вот и хорошо. Мне и так уже становилось всё равно."
    },
    {
      "key": "E62198B941CB5B3916C17687D7685A0F_629A174100000000",
      "source_crc32": 2024376360,
      "translation": "Между гением и случайным поджогом - тонкая грань."
    },
    {
      "key": "E638460340A2A637F4150A982D7484F9_DF32DCAE00000000",
      "source_crc32": 2297802633,
      "translation": "Запомните этот день - мы только что выиграли выборы!"
    },
    {
      "key": "E63E1E184F6A69B9F7A896A521A89C4F_BCB2CF5000000000",
      "source_crc32": 510877096,
      "translation": "Добро пожаловать, хозяин. Сегодня удача на вашей стороне."
    },
    {
      "key": "E645270841E9DCFFE7013EA59E0BE3CB_CAE9733A00000000",
      "source_crc32": 2264630899,
      "translation": "Да мы теперь чуть ли не монету чеканим."
    },
    {
      "key": "E67763134D1253B25BB0FCBA08CE266B_175ECB3A00000000",
      "source_crc32": 1340719593,
      "translation": "Вы усмиряете бури, что я прячу."
    },
    {
      "key": "E6B5063F40C5F568E4111DAEC022BAC0_2CB05ECA00000000",
      "source_crc32": 1953741247,
      "translation": "К вашим услугам, госпожа!"
    },
    {
      "key": "E6B7C267490EA0F5D2EFB7A9720E8A8E_5324210700000000",
      "source_crc32": 1965987777,
      "translation": "Все тайны тонут в кружке."
    },
    {
      "key": "E6E83A264851E26EE08C07B6F9AAA8D7_175ECB3A00000000",
      "source_crc32": 1751677429,
      "translation": "Клянусь честью, я невиновен в том, что мне вменяют."
    },
    {
      "key": "E71A19E44809C3DEBF584A90E1CCF813_175ECB3A00000000",
      "source_crc32": 2241590875,
      "translation": "Ваши поступки красноречивее любых слов."
    },
    {
      "key": "E734C323453A77D39B165B9084B6EBB5_6DEF7CFD00000000",
      "source_crc32": 1425012863,
      "translation": "Я так горжусь, что работаю под этой крышей."
    },
    {
      "key": "E7B52986453ADBF05951C489500CF768_4360EB4000000000",
      "source_crc32": 136265434,
      "translation": "И чему я удивляюсь? У вас это вошло в привычку."
    },
    {
      "key": "E7F16DAB433DA48003D53A8789A9FAA0_175ECB3A00000000",
      "source_crc32": 2207690707,
      "translation": "Смело. Рискованно. Возможно, губительно."
    },
    {
      "key": "E8182D0E4217E315E70454B3A5BE0FC3_2CB05ECA00000000",
      "source_crc32": 1634371333,
      "translation": "Наконец-то в кладовой порядок."
    },
    {
      "key": "E83177D6436523F910BE5891A08F494A_C34977F700000000",
      "source_crc32": 242253023,
      "translation": "А, теперь, значит, не умереть - уже заслуга. Буду знать."
    },
    {
      "key": "E8317C82405FCD37AA48C98C184A0993_CAE9733A00000000",
      "source_crc32": 3645746608,
      "translation": "Постойте… но я же был лучшим, что здесь есть!"
    },
    {
      "key": "E83B6F0E46E426D1ADA30D80357E31D4_6DEF7CFD00000000",
      "source_crc32": 1232345274,
      "translation": "Как славно, что народу у нас прибавится."
    },
    {
      "key": "E83C68AA44AFA411A4421E8C7ED5246E_9AD5AFAC00000000",
      "source_crc32": 3127299146,
      "translation": "Да! Конечно! …А что это?"
    },
    {
      "key": "E88FA7704FF9B7C258E37FBD3B84358D_DF32DCAE00000000",
      "source_crc32": 3588250610,
      "translation": "Тут не на что тратить моё время. Вы свободны."
    },
    {
      "key": "E891B59E44B1BA42AECD0884034A7BD0_D1251AB100000000",
      "source_crc32": 3536176628,
      "translation": "Не пожалеете ни монеты."
    },
    {
      "key": "E8B6BE174EF5398D41967285C24E6AA3_6DEF7CFD00000000",
      "source_crc32": 604299517,
      "translation": "Пора укладывать инструменты спать."
    },
    {
      "key": "E8FA8EF54F1B9B7B9B4F4793767AC2ED_CF0B56A100000000",
      "source_crc32": 3517150778,
      "translation": "Моё внимание вы заслужили. Распорядитесь им с умом."
    },
    {
      "key": "E96BDFAC4E7B91160D2705B8B843E666_5324210700000000",
      "source_crc32": 3876995302,
      "translation": "Отличный план. Давайте в этот раз обойдёмся без ножа под рёбра."
    },
    {
      "key": "E9C572E54CFA930C1728EF96A4BAF272_5DC48C6600000000",
      "source_crc32": 3035083828,
      "translation": "Вам повезло: при луне я блистаю."
    },
    {
      "key": "E9D851754F491B5EE373AF803C84F43A_81104BAA00000000",
      "source_crc32": 4249256342,
      "translation": "Я ухожу! Постойте… а за сегодня мне заплатят?"
    },
    {
      "key": "E9FAB88643827C20AC6D5389852B6C9A_175ECB3A00000000",
      "source_crc32": 799188776,
      "translation": "Только знайте: люблю я всерьёз. И забываю нескоро."
    },
    {
      "key": "EA1459B24151126DD0A78DBF042A9F52_23F7653C00000000",
      "source_crc32": 2478011256,
      "translation": "Меньше помех. Больше работы."
    },
    {
      "key": "EA350AC14F5A666BAFE9EAA23DF86F3A_CAE9733A00000000",
      "source_crc32": 2199991287,
      "translation": "Просторно… как мой талант."
    },
    {
      "key": "EA3E7DF04AF49AFE468EEE87B19AAAEA_175ECB3A00000000",
      "source_crc32": 1726769602,
      "translation": "Любопытно. Вы весьма убедительно доказываете, что вас лучше обходить."
    },
    {
      "key": "EA694C78466415E0003AFF9EA9EB081F_629A174100000000",
      "source_crc32": 3719927280,
      "translation": "Хозяйка пришла - как раз вовремя! Мы всё сделали, как вы велели."
    },
    {
      "key": "EA75471B46A79FA5FB673D860A04EA3C_EA47A70D00000000",
      "source_crc32": 563587888,
      "translation": "Хозяйка пришла - похоже, придётся работать."
    },
    {
      "key": "EAD02B944AF72BC134CA33BB84D11EEB_EA47A70D00000000",
      "source_crc32": 4106682840,
      "translation": "Может, работай я меньше, успевала бы больше. Не думали об этом?"
    },
    {
      "key": "EB296C41499C5D61CD11528C3780D6A7_DF32DCAE00000000",
      "source_crc32": 1326851863,
      "translation": "Впечатляет. Характера у вас больше, чем я полагала."
    },
    {
      "key": "EB567A8342069B1F7A549A8AF5DB1A2F_1C82B0F900000000",
      "source_crc32": 1382268403,
      "translation": "Ещё больше искать? Значит, больше ходить."
    },
    {
      "key": "EB7C921E4EAE4CA88CDE75BC8F85FE4B_5B5D6DF000000000",
      "source_crc32": 2094624509,
      "translation": "Старание вижу. А вот вкус разделить не могу."
    },
    {
      "key": "EBA63A9D427271ED7CCA2BB91D9BBEE5_9AD5AFAC00000000",
      "source_crc32": 1445134276,
      "translation": "Хозяйка здесь - все подтянулись!"
    },
    {
      "key": "EC28F4DC4DA30229B32FE796394CBEB8_9399272200000000",
      "source_crc32": 2207690707,
      "translation": "Смело. Рискованно. Возможно, губительно."
    },
    {
      "key": "EC45ED804742BEC6E9992C88763CD90C_81104BAA00000000",
      "source_crc32": 780425959,
      "translation": "Наградные?! Я и не знал, что такое бывает!"
    },
    {
      "key": "EC7358B942A68324828C60BF0A34AFDD_716D583500000000",
      "source_crc32": 3484060066,
      "translation": "Новое дело для моих рук."
    },
    {
      "key": "EC741C5F49453C9AA4D386A410CC49BD_2CB05ECA00000000",
      "source_crc32": 2974306234,
      "translation": "Я продолжу. Это просто царапина."
    },
    {
      "key": "EC91714B48C4A49C6D4E37B1F4AE785C_CAE9733A00000000",
      "source_crc32": 4256140876,
      "translation": "Наконец мир увидел, чего я стою."
    },
    {
      "key": "ECA9E2334655D166B6FB64976CCF8462_1C82B0F900000000",
      "source_crc32": 2404732814,
      "translation": "Красивее стало, спору нет… было бы ещё где прилечь - и вовсе чудо."
    },
    {
      "key": "ECFF1A484D375F92CBBEAA84F7FE36B6_716D583500000000",
      "source_crc32": 3112272146,
      "translation": "Удивительно, как быстро бегут часы."
    },
    {
      "key": "ED0548A0462FF42C946DAC8FE0E44940_629A174100000000",
      "source_crc32": 4191133026,
      "translation": "Отлично! Если взорвётся, хоть узнаем, где ошибка."
    },
    {
      "key": "ED183F75483C357E16D34E8D53947CDE_EA47A70D00000000",
      "source_crc32": 1612699302,
      "translation": "Вы выросли в моих глазах… хотя это было нетрудно."
    },
    {
      "key": "ED6CCA1143733B825DF6F687D31A559B_F335A94A00000000",
      "source_crc32": 2359417715,
      "translation": "Добро пожаловать! У нас всё в порядке."
    },
    {
      "key": "EE4A20C747E7792790794C89622B925C_1C82B0F900000000",
      "source_crc32": 3100425124,
      "translation": "Что ж, теперь займусь истинным призванием - сном."
    },
    {
      "key": "EE8A938141654A0550928791D5CC74D8_CF0B56A100000000",
      "source_crc32": 179409748,
      "translation": "Да, это я. И сделал бы снова, если б пришлось."
    },
    {
      "key": "EF1F64C54AE5B120AF91409B7972764F_CF0B56A100000000",
      "source_crc32": 1561990229,
      "translation": "Одно доброе дело прошлого не сотрёт, но я его запомню."
    },
    {
      "key": "EF21F8BE47A1A7ED7CC694B7D492818B_9399272200000000",
      "source_crc32": 3550635832,
      "translation": "Это предательство ранит тем больнее, что вы были мне дороги."
    },
    {
      "key": "EF736EAC4386F91B20669F8BD189CDE7_CCF96D7300000000",
      "source_crc32": 3719927280,
      "translation": "Хозяйка пришла - как раз вовремя! Мы всё сделали, как вы велели."
    },
    {
      "key": "EFCDF8A246FF231326C59EB2B453CAFD_175ECB3A00000000",
      "source_crc32": 3729784685,
      "translation": "Вы могли бы оставить меня равнодушным. А оставили шрам."
    },
    {
      "key": "EFCF28FC4C4641F41924368008E46A28_DF32DCAE00000000",
      "source_crc32": 3901225833,
      "translation": "Вы перешли черту. Извинениями тут не помочь."
    },
    {
      "key": "EFEF80FB4E97195BFA9581B675C404F6_CF0B56A100000000",
      "source_crc32": 1148828408,
      "translation": "Долго же до вас доходило!"
    },
    {
      "key": "F021F5B441A972B3B9C761BEF6024F2E_DF32DCAE00000000",
      "source_crc32": 2129708633,
      "translation": "Наконец я вижу в вас что-то, достойное уважения."
    },
    {
      "key": "F035B57A4B2454F3766B1FB9129AFA3D_2CB05ECA00000000",
      "source_crc32": 2559272005,
      "translation": "Понятно. Сделаю как следует."
    },
    {
      "key": "F05F7F8D4F77F9D1BD9475BDE8D17DDB_EA47A70D00000000",
      "source_crc32": 1823226663,
      "translation": "Готово. А где эль?"
    },
    {
      "key": "F0C5B0DE4E043E8AE15ACC891B229FD1_4360EB4000000000",
      "source_crc32": 3627820002,
      "translation": "Если это должно было меня очаровать… считайте, что не вышло."
    },
    {
      "key": "F10E4CD04048F52BE41F94BEFBA88D30_D24AD10000000000",
      "source_crc32": 3867198551,
      "translation": "Спасибо, что развеяли все сомнения насчёт своего нрава."
    },
    {
      "key": "F12D6B544FDD412E4E6E34A7D3813467_C34977F700000000",
      "source_crc32": 3876995302,
      "translation": "Отличный план. Давайте в этот раз обойдёмся без ножа под рёбра."
    },
    {
      "key": "F1A1BBFB439CE01868C24E86477CF50E_CAE9733A00000000",
      "source_crc32": 213475914,
      "translation": "Посторонитесь - величие за работой."
    },
    {
      "key": "F1B1FEA445F81EA65E686CA28F9C0C7E_5324210700000000",
      "source_crc32": 4156763779,
      "translation": "Хозяйка пожаловала. Кавардак как всегда."
    },
    {
      "key": "F1F2A87A4807FD4AFF6FD0B09A6BD6EB_CAE9733A00000000",
      "source_crc32": 87273400,
      "translation": "Доверьтесь мне! Я видел, как это делается, целых два раза!"
    },
    {
      "key": "F235FEEE40239417396B35B4DE6C7853_1C82B0F900000000",
      "source_crc32": 2636190786,
      "translation": "Новая задача? Похоже, работы прибавится."
    },
    {
      "key": "F24A4F804923A40D40CAA087FD82956D_D24AD10000000000",
      "source_crc32": 3966820336,
      "translation": "Это было сделано на редкость изящно."
    },
    {
      "key": "F257D77B433EA3B7C7132F89C0C57542_2CB05ECA00000000",
      "source_crc32": 2535987217,
      "translation": "Мастер - не значит добряк. Значит - работает чисто."
    },
    {
      "key": "F269D32049562FEA99B20D80F29FB500_5DC48C6600000000",
      "source_crc32": 3645746608,
      "translation": "Постойте… но я же была лучшим, что здесь есть!"
    },
    {
      "key": "F298E23943529809877721B1DE533085_D1251AB100000000",
      "source_crc32": 3488665955,
      "translation": "Хорошие ингредиенты теперь искать проще."
    },
    {
      "key": "F2A8C01047C1C9B92F1DBBB0F58D3984_4360EB4000000000",
      "source_crc32": 3996452729,
      "translation": "Вы меня балуете. Не увлекайтесь, а то я привыкну."
    },
    {
      "key": "F2B50FBD40B5F0DEAB538D971CD2E2EE_6562362600000000",
      "source_crc32": 1408152285,
      "translation": "Говорят, уборка прогонит духов. А я скажу… не всех."
    },
    {
      "key": "F3827600403AF2769F1691BF5F73ACE7_5DC48C6600000000",
      "source_crc32": 4256140876,
      "translation": "Наконец мир увидел, чего я стою."
    },
    {
      "key": "F3C26A9349756F9653F9F1AE952A2F93_6DEF7CFD00000000",
      "source_crc32": 3028474138,
      "translation": "Как всегда, постараюсь."
    },
    {
      "key": "F3D29C6547F549DC07F70DBBE2A4AFB5_CF0B56A100000000",
      "source_crc32": 2026102979,
      "translation": "Я не был вам врагом. Теперь - другое дело."
    },
    {
      "key": "F3E21D8C4D48618112BC429DEB4D20DC_9399272200000000",
      "source_crc32": 1726769602,
      "translation": "Любопытно. Вы весьма убедительно доказываете, что вас лучше обходить."
    },
    {
      "key": "F4715FFC4D76DAB82003ABA4C2A2EA83_2CB05ECA00000000",
      "source_crc32": 34236956,
      "translation": "Трудиться приятнее на того, кто этого стоит."
    },
    {
      "key": "F473EEE842E73391ED8898BE70B26079_CF0B56A100000000",
      "source_crc32": 2322486303,
      "translation": "Зря я вас не останавливаю. Ох, зря."
    },
    {
      "key": "F4A33CD7462CD2A7901ADF80B927EB50_D1251AB100000000",
      "source_crc32": 1960779640,
      "translation": "Не подачка - заработанное."
    },
    {
      "key": "F4AE06514A9134A94194509F519E96A4_81104BAA00000000",
      "source_crc32": 371704450,
      "translation": "Нас никто не заметит - если не будут присматриваться."
    },
    {
      "key": "F4E22FBC463695AB9C6400BF3B3820F3_5B5D6DF000000000",
      "source_crc32": 1591746298,
      "translation": "Вы невиновны. Пусть всем вернётся покой."
    },
    {
      "key": "F4EBAFD949B4C8DDE1B20B99803FD62A_5B5D6DF000000000",
      "source_crc32": 2044599336,
      "translation": "Для меня это непривычно… и всё же я не против."
    },
    {
      "key": "F54D2DD7496B2D44AD54A0AB0113AC0A_81CC668A00000000",
      "source_crc32": 3686499461,
      "translation": "Ох, придётся придумать новую систему ярлыков."
    },
    {
      "key": "F5C1B6F0443002C025F33595DDDF195B_5B5D6DF000000000",
      "source_crc32": 893774448,
      "translation": "В своей мерзости вы хотя бы постоянны."
    },
    {
      "key": "F618C2894A338D88A14043BE964F109A_4360EB4000000000",
      "source_crc32": 27552087,
      "translation": "Что сработало: мои речи? Обаяние? Точёный профиль?"
    },
    {
      "key": "F62A63F947DF1335722727BB9CB34EF7_EA47A70D00000000",
      "source_crc32": 718419737,
      "translation": "Если понадоблюсь - я рядом. Поблизости. Отдыхаю."
    },
    {
      "key": "F65955F7415EBA46872222872FAC2FBF_716D583500000000",
      "source_crc32": 1825968758,
      "translation": "Мне бы минутку - перевести дух."
    },
    {
      "key": "F65963B34116E0FF921F5292A88A600A_23F7653C00000000",
      "source_crc32": 1510820456,
      "translation": "Премия? Я перестарался?"
    },
    {
      "key": "F69DDDCB49B5DEEC9438F0B8E7BADEA4_1C82B0F900000000",
      "source_crc32": 788310895,
      "translation": "У каждого свой ритм. Мой просто… помедленнее."
    },
    {
      "key": "F6A015CE41EB77145401019E36861852_81104BAA00000000",
      "source_crc32": 2874397869,
      "translation": "Горло какое-то странное. Это чума? Я умираю?"
    },
    {
      "key": "F6C9872B46095477EA321D84F25CF28F_D24AD10000000000",
      "source_crc32": 71528983,
      "translation": "Может, сделаем вид, что этого не было?"
    },
    {
      "key": "F71DA6BE4513E3A68922F7BEC4334B5B_DF32DCAE00000000",
      "source_crc32": 114413495,
      "translation": "Как бы то ни было, вы встали на сторону победителя."
    },
    {
      "key": "F72D774B45F3238A26B1BE89BD73CF55_DF32DCAE00000000",
      "source_crc32": 2026102979,
      "translation": "Я не была вам врагом. Теперь - другое дело."
    },
    {
      "key": "F74694BB449D3716FD8C49968F34B2E1_CAE9733A00000000",
      "source_crc32": 1077277143,
      "translation": "Ах да, красоте нужен сон."
    },
    {
      "key": "F752D2424B9F1BF1898DCE955428226C_23F7653C00000000",
      "source_crc32": 1270562313,
      "translation": "Идеально. Значит, я что-то упустил."
    },
    {
      "key": "F76A53B2408A00BABDA6FD9EF9CAF64D_716D583500000000",
      "source_crc32": 1064262120,
      "translation": "Всегда рада вас видеть, хозяин."
    },
    {
      "key": "F788C42841A787487AAD39B6D8428C5B_6DEF7CFD00000000",
      "source_crc32": 1064262120,
      "translation": "Всегда рад вас видеть, хозяин."
    },
    {
      "key": "F7C4276649823E4C91F829A2643C8F6D_23F7653C00000000",
      "source_crc32": 1057511498,
      "translation": "Пока не идеально. Значит, неправильно."
    },
    {
      "key": "F7D996274F2739213F174FB96CD75751_9399272200000000",
      "source_crc32": 799188776,
      "translation": "Только знайте: люблю я всерьёз. И забываю нескоро."
    },
    {
      "key": "F839195447B030465C7DEEA8D4B370AC_D1251AB100000000",
      "source_crc32": 393027861,
      "translation": "Сделано как положено."
    },
    {
      "key": "F8A64A6B492477636BF3FDB8B3E2807C_1C82B0F900000000",
      "source_crc32": 563587888,
      "translation": "Хозяйка пришла - похоже, придётся работать."
    },
    {
      "key": "F904A1884B497D41E4763282ED31C1DB_BCB2CF5000000000",
      "source_crc32": 314641369,
      "translation": "От духов решётки не спасут."
    },
    {
      "key": "F9493BDC4D07062439FF709D1B29D8F2_5B5D6DF000000000",
      "source_crc32": 3052680544,
      "translation": "Боюсь, всё указывает на вас. Обвинение доказано."
    },
    {
      "key": "F9C48FE94666B5AA1D988590B89480C1_5324210700000000",
      "source_crc32": 242253023,
      "translation": "А, теперь, значит, не умереть - уже заслуга. Буду знать."
    },
    {
      "key": "FA1261B44041C2467F231D851B0E570D_D1251AB100000000",
      "source_crc32": 3776586570,
      "translation": "Смотрится лучше - теперь так и держать."
    },
    {
      "key": "FA57D03D47AD0A42FED15CAFE33B6733_CF0B56A100000000",
      "source_crc32": 2129708633,
      "translation": "Наконец я вижу в вас что-то, достойное уважения."
    },
    {
      "key": "FAEEDD234CBBF334550D85B8970C8BDF_175ECB3A00000000",
      "source_crc32": 1697577819,
      "translation": "Не путайте молчание с примирением."
    },
    {
      "key": "FAFAD55B4B60304CD235AE87C12B672B_CF0B56A100000000",
      "source_crc32": 971888421,
      "translation": "Впредь спросите кого-то со вкусом."
    },
    {
      "key": "FB2CAD5048E285C7CA1517AD78D52032_CF0B56A100000000",
      "source_crc32": 2191314581,
      "translation": "И это всё, на что вы способны?"
    },
    {
      "key": "FB33625E47C6967843B843A8BFFB8E04_A9C21C2000000000",
      "source_crc32": 584306342,
      "translation": "Чувствую, у нас уже расцветает дружба!"
    },
    {
      "key": "FB6CC19B448EF7B272310D825F46E0A0_175ECB3A00000000",
      "source_crc32": 3949851567,
      "translation": "Поддержка чужих людей порой весит больше, чем похвала друзей."
    },
    {
      "key": "FBA38FB94CD3959F2F6E5EB541E41146_716D583500000000",
      "source_crc32": 816013114,
      "translation": "Я? Правда? Тогда буду трудиться ещё усерднее!"
    },
    {
      "key": "FBB0FEC94E69496BD3023CAF85A6C89F_C34977F700000000",
      "source_crc32": 1999605435,
      "translation": "Мило. Жаль, красота не чинит всё остальное."
    },
    {
      "key": "FBB63FCD440F072EA18373AC2D7B0B90_DF32DCAE00000000",
      "source_crc32": 2191314581,
      "translation": "И это всё, на что вы способны?"
    },
    {
      "key": "FBDEA80A4317BBB5FF5308B8375B3746_9399272200000000",
      "source_crc32": 1697577819,
      "translation": "Не путайте молчание с примирением."
    },
    {
      "key": "FC1EDBDF47C839DE468545BD33257BE7_A9C21C2000000000",
      "source_crc32": 3173471996,
      "translation": "Мы же дружили. Что, ради всего святого, случилось?"
    },
    {
      "key": "FC5B5D8F4C7E5152D606CF840EDF6103_9AD5AFAC00000000",
      "source_crc32": 371704450,
      "translation": "Нас никто не заметит - если не будут присматриваться."
    },
    {
      "key": "FC7E106743E0DBC299F8F3BA58A5E8E5_4360EB4000000000",
      "source_crc32": 2993067472,
      "translation": "В следующий раз при встрече любезностей не ждите."
    },
    {
      "key": "FCC4342943B679DFB06F2886A071FA69_CCF96D7300000000",
      "source_crc32": 2024376360,
      "translation": "Между гением и случайным поджогом - тонкая грань."
    },
    {
      "key": "FCF135594ABA052BB61761B09D1971B5_A9C21C2000000000",
      "source_crc32": 3311550708,
      "translation": "Я… такого от вас не ожидал. Ну надо же!"
    },
    {
      "key": "FD4CC0C84E3B672DB854BC9DDCE4B721_F335A94A00000000",
      "source_crc32": 4110593377,
      "translation": "Пора идти. Муж рассердится, если опоздаю."
    },
    {
      "key": "FDA63C4F4E5655C7A6BFFFBC1186D604_6DEF7CFD00000000",
      "source_crc32": 2246536765,
      "translation": "Пожалуй, даже крысы оценят."
    },
    {
      "key": "FDAD5DCE451EFFE39BEC13BBDB4D96CB_4360EB4000000000",
      "source_crc32": 460864964,
      "translation": "Даже враги не устоят перед моим обаянием!"
    },
    {
      "key": "FDD7EEE042B397FAFB1035AA0D3CA0C3_D1251AB100000000",
      "source_crc32": 3232846429,
      "translation": "Дайте место и не мешайте."
    },
    {
      "key": "FDF126854903235F5CAE769EB4C9EC00_9AD5AFAC00000000",
      "source_crc32": 95176815,
      "translation": "Вы что-то сделали с причёской?"
    },
    {
      "key": "FE25598C4C825F04FE22E38E5337DAA7_D1251AB100000000",
      "source_crc32": 1238173848,
      "translation": "Лишние руки помогают. Лишние рты - нет."
    },
    {
      "key": "FE652DCC4679FD0F4ABE5B8076BFC7F2_D24AD10000000000",
      "source_crc32": 3867198551,
      "translation": "Спасибо, что развеяли все сомнения насчёт своего нрава."
    },
    {
      "key": "FE8DD581454792819638D2A83FEF1F86_4360EB4000000000",
      "source_crc32": 27552087,
      "translation": "Что сработало: мои речи? Обаяние? Точёный профиль?"
    },
    {
      "key": "FE9B5E79431B2AC4D78119A408E97726_EA47A70D00000000",
      "source_crc32": 4183100956,
      "translation": "Снаряжение? Богато. А само работать умеет?"
    },
    {
      "key": "FF3E47A0414CEF292082E5A607DB61E0_DF32DCAE00000000",
      "source_crc32": 4286388188,
      "translation": "Я вам доверилась. Больше такой глупости не повторю."
    }
  ]
}
